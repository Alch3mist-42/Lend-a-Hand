<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="48dp" android:paddingBottom="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBurger"
            android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_menu_plus_green"
            android:clickable="true" android:focusable="true"/>

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="14dp"
            android:text="ASTERA"
            android:textColor="@color/primary"
            android:textSize="20sp" android:textStyle="bold"
            android:letterSpacing="0.08"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile hero section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="24dp"
                android:paddingBottom="28dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Avatar with aura -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="14dp">
                    <View android:layout_width="100dp" android:layout_height="100dp"
                        android:background="@drawable/circle_ring_light" android:alpha="0.4"/>
                    <View android:layout_width="82dp" android:layout_height="82dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_ring_light" android:alpha="0.6"/>
                    <TextView android:layout_width="66dp" android:layout_height="66dp"
                        android:layout_gravity="center"
                        android:background="@drawable/avatar_bg_green"
                        android:gravity="center"
                        android:text="OF"
                        android:textColor="@color/white"
                        android:textSize="22sp" android:textStyle="bold"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oratile Fisasi"
                    android:textColor="@color/on_surface"
                    android:textSize="24sp" android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/verified_badge_bg"
                    android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingTop="5dp" android:paddingBottom="5dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌿 " android:textSize="12sp"/>
                    <TextView android:id="@+id/tvRankLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Helper" android:textColor="@color/primary"
                        android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvProfileBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Passionate about community upliftment and education."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" android:gravity="center"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:layout_marginTop="4dp" android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                    <androidx.cardview.widget.CardView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="3dp"
                        app:cardCornerRadius="16dp" app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface_lowest">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="CREDITS" android:textColor="@color/outline"
                                android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:id="@+id/tvCredits"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="42" android:textColor="@color/primary"
                                android:textSize="24sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:layout_marginTop="4dp" android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                    <androidx.cardview.widget.CardView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="3dp"
                        app:cardCornerRadius="16dp" app:cardElevation="0dp"
                        app:cardBackgroundColor="#eef6f4">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="NEXT RANK" android:textColor="@color/primary"
                                android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:id="@+id/tvNextRank"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="18 to\nUplifter" android:textColor="@color/on_surface"
                                android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:layout_marginTop="4dp" android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                    <androidx.cardview.widget.CardView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="3dp"
                        app:cardCornerRadius="16dp" app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface_lowest">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="DONATIONS" android:textColor="@color/outline"
                                android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="24" android:textColor="@color/on_surface"
                                android:textSize="24sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

            </LinearLayout>

            <!-- Donor Lineage -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:layout_marginTop="4dp" android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                    <androidx.cardview.widget.CardView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="3dp"
                        app:cardCornerRadius="20dp" app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface_lowest">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="20dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="DONOR LINEAGE"
                                android:textColor="@color/outline" android:textSize="10sp"
                                android:textStyle="bold" android:letterSpacing="0.08"
                                android:layout_marginBottom="16dp"/>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🌱" android:textSize="16sp" android:alpha="0.4"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="  Seedling"
                                    android:textColor="@color/outline" android:textSize="14sp"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:background="@drawable/verified_badge_bg"
                                android:paddingStart="10dp" android:paddingEnd="10dp"
                                android:paddingTop="8dp" android:paddingBottom="8dp"
                                android:layout_marginBottom="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🌿" android:textSize="18sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="  Helper"
                                    android:textColor="@color/primary" android:textSize="16sp"
                                    android:textStyle="bold" android:layout_marginStart="8dp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="⭐" android:textSize="16sp" android:alpha="0.3"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="  Uplifter"
                                    android:textColor="@color/outline" android:textSize="14sp"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:layout_marginBottom="10dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="⚡" android:textSize="16sp" android:alpha="0.3"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="  Guardian"
                                    android:textColor="@color/outline" android:textSize="14sp"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🛡️" android:textSize="16sp" android:alpha="0.3"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="  Legend"
                                    android:textColor="@color/outline" android:textSize="14sp"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>
            </LinearLayout>

            <!-- Impact Log header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Impact Log"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:id="@+id/btnSeeJourney"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="See Journey ›"
                    android:textColor="@color/primary"
                    android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Impact log cards -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_marginTop="4dp" android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardLog1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp" android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_lowest">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="44dp" android:layout_height="44dp"
                            android:background="@drawable/verified_badge_bg"
                            android:gravity="center" android:text="🌿" android:textSize="18sp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="City Park Reforestation"
                                android:textColor="@color/on_surface" android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Oct 12, 2023 • 12 Credits"
                                android:textColor="@color/outline" android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/outline" android:textSize="18sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_marginTop="4dp" android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardLog2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp" android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_lowest">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="44dp" android:layout_height="44dp"
                            android:background="@drawable/tier3_icon_bg"
                            android:gravity="center" android:text="🥫" android:textSize="18sp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Food Bank Donation"
                                android:textColor="@color/on_surface" android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Sep 3, 2023 • 20 Credits"
                                android:textColor="@color/outline" android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/outline" android:textSize="18sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_marginTop="4dp" android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardLog3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp" android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_lowest">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="44dp" android:layout_height="44dp"
                            android:background="@drawable/tier2_icon_bg"
                            android:gravity="center" android:text="📚" android:textSize="18sp"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Youth Literacy Drive"
                                android:textColor="@color/on_surface" android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Aug 19, 2023 • 10 Credits"
                                android:textColor="@color/outline" android:textSize="12sp"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="›" android:textColor="@color/outline" android:textSize="18sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Expand button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpand"
                style="@style/LendAHand.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:text="Expand +"/>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg" android:elevation="12dp"
        android:orientation="horizontal" android:weightSum="4"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/navDiscover" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_discover" android:layout_gravity="center" android:tint="#aab0b8"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISCOVER" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navDonate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_donate" android:layout_gravity="center" android:tint="#aab0b8"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DONATE" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navActivity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_activity" android:layout_gravity="center" android:tint="#aab0b8"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVITY" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:background="@drawable/nav_active_bg">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_profile" android:layout_gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROFILE" android:textSize="8sp" android:textColor="@color/primary" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>