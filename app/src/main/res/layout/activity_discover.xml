<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface">

        <!-- TOP BAR — white background, green icons -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="48dp" android:paddingBottom="16dp"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBurger"
                android:layout_width="28dp" android:layout_height="28dp"
                android:src="@drawable/ic_menu_plus_green"
                android:clickable="true" android:focusable="true"/>

            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp"
                android:text="ASTERA"
                android:textColor="@color/primary"
                android:textSize="20sp" android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <ImageView
                android:id="@+id/btnBell"
                android:layout_width="26dp" android:layout_height="26dp"
                android:src="@drawable/ic_bell_green"
                android:clickable="true" android:focusable="true"/>

        </LinearLayout>

        <!-- SCROLLABLE CONTENT -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/bottomNav">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ═══════════════════════════════════════ -->
                <!-- HERO CARD — globe + heart + CTA buttons -->
                <!-- ═══════════════════════════════════════ -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp">

                    <!-- Shadow layer for depth -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="6dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/card_shadow_layer"/>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:foreground="@drawable/ripple_card"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface_lowest">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="24dp" android:paddingEnd="24dp"
                            android:paddingTop="24dp" android:paddingBottom="80dp">

                            <!-- Left: text + buttons -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingEnd="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Make an "
                                    android:textColor="@color/on_surface"
                                    android:textSize="30sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="-0.02"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Impact Today."
                                    android:textColor="@color/primary"
                                    android:textSize="30sp"
                                    android:textStyle="bold|italic"
                                    android:letterSpacing="-0.02"
                                    android:layout_marginBottom="12dp"/>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Every hand lent is a bridge built. Choose your path to transform a life."
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="13sp"
                                    android:lineSpacingExtra="3dp"
                                    android:layout_marginBottom="20dp"/>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBecomeGiver"
                                    style="@style/LendAHand.Button.Primary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:text="Become a Giver"
                                    android:textSize="13sp"
                                    android:layout_marginBottom="10dp"/>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnFindNeed"
                                    style="@style/LendAHand.Button.Outlined"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:text="Find a Need"
                                    android:textSize="13sp"/>

                            </LinearLayout>

                            <!-- Right: globe circle + heart badge -->
                            <FrameLayout
                                android:layout_width="120dp"
                                android:layout_height="160dp">

                                <!-- Outer aura -->
                                <View android:layout_width="110dp" android:layout_height="110dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:background="@drawable/circle_ring_light"
                                    android:alpha="0.3"/>

                                <!-- Inner aura -->
                                <View android:layout_width="92dp" android:layout_height="92dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:layout_marginTop="9dp"
                                    android:background="@drawable/circle_ring_light"
                                    android:alpha="0.5"/>

                                <!-- Globe -->
                                <TextView
                                    android:layout_width="74dp" android:layout_height="74dp"
                                    android:layout_gravity="top|center_horizontal"
                                    android:layout_marginTop="18dp"
                                    android:background="@drawable/avatar_bg_green"
                                    android:gravity="center"
                                    android:text="🌍"
                                    android:textSize="30sp"/>

                                <!-- Heart badge -->
                                <LinearLayout
                                    android:layout_width="56dp" android:layout_height="56dp"
                                    android:layout_gravity="bottom|center_horizontal"
                                    android:background="@drawable/heart_badge_bg"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="26dp" android:layout_height="26dp"
                                        android:src="@drawable/ic_heart_outline"/>
                                </LinearLayout>

                            </FrameLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- PRIORITY TIERS SECTION -->
                <!-- ═══════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUPPORT STREAMS"
                        android:textColor="@color/primary"
                        android:textSize="11sp" android:textStyle="bold"
                        android:letterSpacing="0.10"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priority Tiers"
                        android:textColor="@color/on_surface"
                        android:textSize="24sp" android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Tier 1 -->
                            <FrameLayout android:layout_width="185dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardTier1"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card"
                                    app:cardCornerRadius="20dp" app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_low">
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/tier1_icon_bg" android:gravity="center" android:text="⚡" android:textSize="18sp" android:layout_marginBottom="14dp"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tier 1: Critical" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Immediate intervention for health emergencies. Real-time urgency." android:textColor="@color/on_surface_variant" android:textSize="12sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="14dp"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High Priority  ›" android:textColor="@color/error" android:textSize="12sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </FrameLayout>

                            <!-- Tier 2 -->
                            <FrameLayout android:layout_width="185dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardTier2"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card"
                                    app:cardCornerRadius="20dp" app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_lowest">
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/tier2_icon_bg" android:gravity="center" android:text="🎓" android:textSize="18sp" android:layout_marginBottom="14dp"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tier 2: Educational" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Funding school supplies for the next generation." android:textColor="@color/on_surface_variant" android:textSize="12sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="14dp"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Future Focus  ›" android:textColor="@color/secondary" android:textSize="12sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </FrameLayout>

                            <!-- Tier 3 -->
                            <FrameLayout android:layout_width="185dp" android:layout_height="wrap_content" android:layout_marginEnd="20dp">
                                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                                <androidx.cardview.widget.CardView
                                    android:id="@+id/cardTier3"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card"
                                    app:cardCornerRadius="20dp" app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/surface_low">
                                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                                        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/tier3_icon_bg" android:gravity="center" android:text="🍽️" android:textSize="18sp" android:layout_marginBottom="14dp"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tier 3: Sustenance" android:textColor="@color/on_surface" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Long-term food security for growing communities." android:textColor="@color/on_surface_variant" android:textSize="12sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="14dp"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Foundational  ›" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"/>
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </FrameLayout>

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- GUARDIANS CIRCLE BAND                  -->
                <!-- Rounded top edges where green meets white -->
                <!-- ═══════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/guardians_band_bg"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Guardians Circle"
                        android:textColor="@color/white"
                        android:textSize="24sp" android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Honoring those who lead with radical generosity. These Pillars and Legends redefine community impact."
                        android:textColor="#ccffffff"
                        android:textSize="13sp" android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:id="@+id/btnViewLeaderboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp"
                        android:clickable="true" android:focusable="true">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="VIEW FULL LEADERBOARD"
                            android:textColor="@color/white" android:textSize="12sp"
                            android:textStyle="bold" android:letterSpacing="0.08"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="  ›" android:textColor="@color/white"
                            android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Row 1: Marcus Thorne -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:cardCornerRadius="16dp" app:cardElevation="0dp"
                        app:cardBackgroundColor="#1affffff">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                                <View android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                                <TextView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_gold" android:gravity="center" android:text="MT" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Marcus Thorne" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEGENDARY DONOR" android:textColor="@color/tertiary_fixed" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12.5k" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_gravity="end"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="#80ffffff" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:layout_gravity="end"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Row 2: Elena Vance -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        app:cardCornerRadius="16dp" app:cardElevation="0dp"
                        app:cardBackgroundColor="#1affffff">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                                <View android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                                <TextView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_indigo" android:gravity="center" android:text="EV" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Elena Vance" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PILLAR OF SUPPORT" android:textColor="#ccffffff" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8.2k" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_gravity="end"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="#80ffffff" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:layout_gravity="end"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Row 3: Dr. Julian Gray -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp" app:cardElevation="0dp"
                        app:cardBackgroundColor="#1affffff">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                                <View android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                                <TextView android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_green" android:gravity="center" android:text="JG" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                            </FrameLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. Julian Gray" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PILLAR OF SUPPORT" android:textColor="#ccffffff" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7.9k" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" android:layout_gravity="end"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="#80ffffff" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.06" android:layout_gravity="end"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>



            </LinearLayout>
        </ScrollView>

        <!-- BOTTOM NAV -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent" android:layout_height="80dp"
            android:background="@drawable/bottom_nav_bg" android:elevation="12dp"
            android:orientation="horizontal" android:weightSum="4"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout android:id="@+id/navDiscover" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:background="@drawable/nav_active_bg">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_discover" android:layout_gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISCOVER" android:textSize="8sp" android:textColor="@color/primary" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navDonate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_donate" android:layout_gravity="center" android:tint="#aab0b8"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DONATE" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navActivity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_activity" android:layout_gravity="center" android:tint="#aab0b8"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVITY" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_profile" android:layout_gravity="center" android:tint="#aab0b8"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROFILE" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER -->
    <include layout="@layout/drawer_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
