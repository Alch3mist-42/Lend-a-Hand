                        <TextView
                            android:id="@+id/tvQty_canned"
                            style="@style/QtyText"
                            android:text="0"/>
                        <Button
                            android:id="@+id/btnPlus_canned"
                            style="@style/StepBtn"
                            android:text="+"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Item: Baby formula -->
