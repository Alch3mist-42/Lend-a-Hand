                            style="@style/QtyText"
                            android:text="0"/>
                        <Button
                            android:id="@+id/btnPlus_sanitary"
                            style="@style/StepBtn"
                            android:text="+"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ SECTION: Clothing ══ -->
