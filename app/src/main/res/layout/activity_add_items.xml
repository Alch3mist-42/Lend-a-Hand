<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fb">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="52dp"
        android:paddingEnd="24dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/chip_inactive"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:text="ASTERA"
            android:textColor="#aaffffff"
            android:textSize="10sp" android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Items"
            android:textColor="@color/white"
            android:textSize="30sp" android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <TextView
            android:id="@+id/tvItemScreenSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="What would you like to donate?"
            android:textColor="#80ffffff" android:textSize="14sp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <TextView android:id="@+id/chipAll"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/chip_active"
                    android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:text="All" android:textColor="@color/primary"
                    android:textSize="13sp" android:textStyle="bold"/>

                <TextView android:id="@+id/chipFood"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/chip_inactive"
                    android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:text="🥫 Food" android:textColor="#ccffffff"
                    android:textSize="13sp" android:textStyle="bold"/>

                <TextView android:id="@+id/chipHygiene"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/chip_inactive"
                    android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:text="🧴 Hygiene" android:textColor="#ccffffff"
                    android:textSize="13sp" android:textStyle="bold"/>

                <TextView android:id="@+id/chipClothing"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/chip_inactive"
                    android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:text="👕 Clothing" android:textColor="#ccffffff"
                    android:textSize="13sp" android:textStyle="bold"/>

                <TextView android:id="@+id/chipHousehold"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/chip_inactive"
                    android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:text="🏠 Home" android:textColor="#ccffffff"
                    android:textSize="13sp" android:textStyle="bold"/>

                <TextView android:id="@+id/chipSchool"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/chip_inactive"
                    android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:text="📚 School" android:textColor="#ccffffff"
                    android:textSize="13sp" android:textStyle="bold"/>

                <TextView android:id="@+id/chipMedical"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:background="@drawable/chip_inactive"
                    android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:text="💊 Medical" android:textColor="#ccffffff"
                    android:textSize="13sp" android:textStyle="bold"/>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- SCROLLABLE LIST -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="12dp">

            <!-- FOOD -->
            <TextView android:id="@+id/sectionFood" style="@style/CategoryLabel" android:text="🥫  Food &amp; Nutrition"/>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:layout_marginStart="1dp" android:layout_marginEnd="1dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardFood1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout style="@style/ItemCardInner">
                        <TextView style="@style/ItemName" android:text="Non-perishables"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/stepper_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                            <Button android:id="@+id/btnMinusFood1" style="@style/StepBtn" android:text="−"/>
                            <TextView android:id="@+id/tvQtyFood1" style="@style/QtyText" android:text="0"/>
                            <Button android:id="@+id/btnPlusFood1" style="@style/StepBtn" android:text="+"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:layout_marginStart="1dp" android:layout_marginEnd="1dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardFood2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout style="@style/ItemCardInner">
                        <TextView style="@style/ItemName" android:text="Canned food"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/stepper_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                            <Button android:id="@+id/btnMinusFood2" style="@style/StepBtn" android:text="−"/>
                            <TextView android:id="@+id/tvQtyFood2" style="@style/QtyText" android:text="0"/>
                            <Button android:id="@+id/btnPlusFood2" style="@style/StepBtn" android:text="+"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:layout_marginStart="1dp" android:layout_marginEnd="1dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardFood3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout style="@style/ItemCardInner">
                        <TextView style="@style/ItemName" android:text="Baby formula"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/stepper_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                            <Button android:id="@+id/btnMinusFood3" style="@style/StepBtn" android:text="−"/>
                            <TextView android:id="@+id/tvQtyFood3" style="@style/QtyText" android:text="0"/>
                            <Button android:id="@+id/btnPlusFood3" style="@style/StepBtn" android:text="+"/>
