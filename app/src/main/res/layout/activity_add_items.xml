                        android:layout_height="40dp"
                        android:background="@drawable/stepper_pill"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <Button
                            android:id="@+id/btnMinus_insulin"
                            style="@style/StepBtn"
                            android:text="−"/>
                        <TextView
                            android:id="@+id/tvQty_insulin"
                            style="@style/QtyText"
                            android:text="0"/>
                        <Button
                            android:id="@+id/btnPlus_insulin"
                            style="@style/StepBtn"
                            android:text="+"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Save CTA -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="Save"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/btn_green_pill"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- ═══ BOTTOM NAV - Donate Active ═══ -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_gravity="bottom">

        <!-- Discover (Inactive) -->
        <LinearLayout
            android:id="@+id/navDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_discover"
                android:layout_gravity="center"
                android:tint="#aab0b8"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCOVER"
                android:textSize="8sp"
                android:textColor="#aab0b8"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="3dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- Donate (Active - with pill) -->
        <LinearLayout
            android:id="@+id/navDonate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/nav_active_bg">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_donate"
                android:layout_gravity="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DONATE"
                android:textSize="8sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="3dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- Activity (Inactive) -->
        <LinearLayout
            android:id="@+id/navActivity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_activity"
                android:layout_gravity="center"
                android:tint="#aab0b8"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVITY"
                android:textSize="8sp"
                android:textColor="#aab0b8"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="3dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- Profile (Inactive) -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_profile"
                android:layout_gravity="center"
                android:tint="#aab0b8"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                android:textSize="8sp"
                android:textColor="#aab0b8"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="3dp"
                android:layout_gravity="center"/>
        </LinearLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>