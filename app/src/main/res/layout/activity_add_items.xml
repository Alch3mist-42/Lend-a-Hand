<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_low">

    <!-- ═══ STICKY HEADER ═══ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="52dp"
            android:paddingBottom="0dp"
            android:paddingHorizontal="24dp">

            <!-- App label pill -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASTERA"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:background="@drawable/label_pill_alpha"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginBottom="12dp"/>

            <!-- Big title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Items"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What would you like to donate?"
                android:textColor="#B2FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="20dp"/>

            <!-- Category filter chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingBottom="20dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/chipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="All"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:background="@drawable/chip_white_active"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/chipFood"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🥫  Food"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:background="@drawable/chip_ghost"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/chipHygiene"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🧴  Hygiene"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:background="@drawable/chip_ghost"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/chipClothing"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="👕  Clothing"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:background="@drawable/chip_ghost"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/chipSchool"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="📚  School"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:background="@drawable/chip_ghost"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/chipMedical"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="💊  Medical"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:paddingHorizontal="22dp"
                        android:background="@drawable/chip_ghost"/>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══ SCROLLABLE CONTENT ═══ -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:scrollbars="none"
        android:paddingBottom="88dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/itemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingHorizontal="16dp">

            <!-- ══ SECTION: Food & Essentials ══ -->
            <LinearLayout
                android:id="@+id/sectionFood"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/section_header_bg"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥫"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food &amp; Essentials"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Item: Non-perishables -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNonPerishables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_lowest">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Non-perishables"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/stepper_pill"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <Button
                            android:id="@+id/btnMinus_nonPerish"
                            style="@style/StepBtn"
                            android:text="−"/>
                        <TextView
                            android:id="@+id/tvQty_nonPerish"
                            style="@style/QtyText"
                            android:text="0"/>
                        <Button
                            android:id="@+id/btnPlus_nonPerish"
                            style="@style/StepBtn"
                            android:text="+"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Item: Canned food -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCannedFood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_lowest">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Canned food"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"/>
                    <LinearLayout
