<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvRecipientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2D3748"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:text="Recipient Name" />

        <TextView
            android:id="@+id/tvMotivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#4A5568"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textStyle="italic"
            android:text="Motivation message goes here..." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#EDF2F7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etAllocateAmount"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Enter amount..."
                android:inputType="number"
                android:textSize="14sp"
                android:textColor="#2D3748" />

            <Button
                android:id="@+id/btnAllocate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#48BB78"
                android:text="Allocate"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="20dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>