<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="52dp" android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView android:id="@+id/btnBack"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹" android:textColor="@color/white"
            android:textSize="22sp" android:layout_marginEnd="16dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Your Journey"
                android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Every step you've taken matters"
                android:textColor="#80ffffff" android:textSize="13sp" android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/journeyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:background="@color/surface"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="48dp">

            <!-- Current rank banner -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginBottom="32dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_marginTop="5dp" android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/primary">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:padding="20dp"
                        android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="CURRENT RANK" android:textColor="#80ffffff"
                                android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="🌿 Helper" android:textColor="@color/white"
                                android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="42 credits  •  18 to Uplifter"
                                android:textColor="#ccffffff" android:textSize="13sp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                        <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
                            <View android:layout_width="64dp" android:layout_height="64dp"
                                android:background="@drawable/circle_ring_light" android:alpha="0.25"/>
                            <TextView android:layout_width="52dp" android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/avatar_bg_gold"
                                android:gravity="center" android:text="OF"
                                android:textColor="@color/white" android:textSize="16sp"
                                android:textStyle="bold"/>
                        </FrameLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- TREE STRUCTURE — trunk runs down the centre     -->
            <!-- Each tier is a branch node on the trunk         -->
            <!-- ═══════════════════════════════════════════════ -->

            <!-- LEGEND (top of tree — locked) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:alpha="0.3">
                <!-- Left branch line -->
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/outline_variant"/>
                <!-- Node -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="56dp" android:layout_height="56dp"
                        android:background="@drawable/verified_badge_bg"
                        android:gravity="center" android:text="🛡️" android:textSize="22sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Legend" android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginTop="6dp" android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="250 credits" android:textColor="@color/outline"
                        android:textSize="11sp" android:layout_gravity="center"/>
                </LinearLayout>
                <!-- Right branch line -->
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/outline_variant"/>
            </LinearLayout>

            <!-- Trunk connector -->
            <View android:layout_width="2dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/outline_variant"
                android:layout_marginStart="0dp"/>

            <!-- GUARDIAN (locked) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="40dp" android:paddingEnd="40dp"
                android:alpha="0.3">
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/outline_variant"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp"
                        android:background="@drawable/verified_badge_bg"
                        android:gravity="center" android:text="⚡" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Guardian" android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginTop="6dp" android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="120 credits" android:textColor="@color/outline"
                        android:textSize="11sp" android:layout_gravity="center"/>
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/outline_variant"/>
            </LinearLayout>

            <!-- Trunk connector -->
            <View android:layout_width="2dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/outline_variant"/>

            <!-- UPLIFTER (locked) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="56dp" android:paddingEnd="56dp"
                android:alpha="0.35">
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/outline_variant"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="52dp" android:layout_height="52dp"
                        android:background="@drawable/verified_badge_bg"
                        android:gravity="center" android:text="⭐" android:textSize="20sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Uplifter" android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_marginTop="6dp" android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="18 to go" android:textColor="@color/secondary"
                        android:textSize="11sp" android:textStyle="bold"
                        android:layout_gravity="center"/>
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/outline_variant"/>
            </LinearLayout>

            <!-- Trunk connector — primary colour (active path) -->
            <View android:layout_width="2dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/primary"/>

            <!-- HELPER (ACTIVE — current rank) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="16dp" android:paddingEnd="16dp">

                <!-- Left branch with impact cards -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <!-- Branch line -->
                    <View android:layout_width="match_parent" android:layout_height="2dp"
                        android:background="@color/primary" android:layout_marginBottom="8dp"/>

                    <!-- Impact card 1 -->
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:layout_marginTop="3dp" android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                        <androidx.cardview.widget.CardView android:id="@+id/cardImpact1"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp" android:foreground="@drawable/ripple_card"
                            app:cardCornerRadius="14dp" app:cardElevation="0dp"
                            app:cardBackgroundColor="#ffffff">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:padding="12dp"
                                android:gravity="center_vertical">
                                <TextView android:layout_width="36dp" android:layout_height="36dp"
                                    android:background="@drawable/verified_badge_bg"
                                    android:gravity="center" android:text="🌿" android:textSize="14sp"/>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:orientation="vertical"
                                    android:layout_marginStart="10dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="City Park" android:textColor="@color/on_surface"
                                        android:textSize="12sp" android:textStyle="bold"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="12 credits" android:textColor="@color/primary"
                                        android:textSize="10sp" android:layout_marginTop="2dp"/>
                                </LinearLayout>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="›" android:textColor="@color/outline" android:textSize="16sp"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <!-- Impact card 2 -->
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:layout_marginTop="3dp" android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                        <androidx.cardview.widget.CardView android:id="@+id/cardImpact2"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp" android:foreground="@drawable/ripple_card"
                            app:cardCornerRadius="14dp" app:cardElevation="0dp"
                            app:cardBackgroundColor="#ffffff">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:padding="12dp"
                                android:gravity="center_vertical">
                                <TextView android:layout_width="36dp" android:layout_height="36dp"
                                    android:background="@drawable/tier3_icon_bg"
                                    android:gravity="center" android:text="🍽️" android:textSize="14sp"/>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:orientation="vertical"
                                    android:layout_marginStart="10dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Food Bank" android:textColor="@color/on_surface"
                                        android:textSize="12sp" android:textStyle="bold"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="20 credits" android:textColor="@color/primary"
                                        android:textSize="10sp" android:layout_marginTop="2dp"/>
                                </LinearLayout>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="›" android:textColor="@color/outline" android:textSize="16sp"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                </LinearLayout>

                <!-- Centre node — HELPER -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
                    <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
                        <View android:layout_width="72dp" android:layout_height="72dp"
                            android:background="@drawable/circle_ring_light" android:alpha="0.4"/>
                        <View android:layout_width="58dp" android:layout_height="58dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_ring_light" android:alpha="0.6"/>
                        <TextView android:layout_width="46dp" android:layout_height="46dp"
                            android:layout_gravity="center"
                            android:background="@drawable/avatar_bg_green"
                            android:gravity="center" android:text="🌿"
                            android:textSize="20sp"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Helper" android:textColor="@color/primary"
                        android:textSize="14sp" android:textStyle="bold"
                        android:layout_gravity="center" android:layout_marginTop="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="YOU ARE HERE"
                        android:textColor="@color/primary" android:textSize="9sp"
                        android:textStyle="bold" android:letterSpacing="0.06"
                        android:layout_gravity="center"/>
                </LinearLayout>

                <!-- Right branch with impact card -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:paddingStart="8dp">

                    <View android:layout_width="match_parent" android:layout_height="2dp"
                        android:background="@color/primary" android:layout_marginBottom="8dp"/>

                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:layout_marginTop="3dp" android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp" android:background="@drawable/card_shadow_layer"/>
                        <androidx.cardview.widget.CardView android:id="@+id/cardImpact3"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp" android:foreground="@drawable/ripple_card"
                            app:cardCornerRadius="14dp" app:cardElevation="0dp"
                            app:cardBackgroundColor="#ffffff">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:padding="12dp"
                                android:gravity="center_vertical">
                                <TextView android:layout_width="36dp" android:layout_height="36dp"
                                    android:background="@drawable/tier2_icon_bg"
                                    android:gravity="center" android:text="🎓" android:textSize="14sp"/>
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                    android:layout_weight="1" android:orientation="vertical"
                                    android:layout_marginStart="10dp">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="Youth Literacy" android:textColor="@color/on_surface"
                                        android:textSize="12sp" android:textStyle="bold"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="10 credits  •  First!" android:textColor="@color/primary"
                                        android:textSize="10sp" android:layout_marginTop="2dp"/>
                                </LinearLayout>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="›" android:textColor="@color/outline" android:textSize="16sp"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Trunk connector — primary (done path) -->
            <View android:layout_width="2dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/primary"/>

            <!-- SEEDLING (done — root of tree) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="56dp" android:paddingEnd="56dp">
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/primary"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
                    <FrameLayout android:layout_width="56dp" android:layout_height="56dp">
                        <View android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/circle_ring_light" android:alpha="0.4"/>
                        <TextView android:layout_width="44dp" android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/avatar_bg_green"
                            android:gravity="center" android:text="🌱" android:textSize="18sp"/>
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Seedling" android:textColor="@color/primary"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_gravity="center" android:layout_marginTop="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Where it began" android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" android:layout_gravity="center"/>
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="2dp"
                    android:layout_weight="1" android:background="@color/primary"/>
            </LinearLayout>

            <!-- Root trunk bottom -->
            <View android:layout_width="2dp" android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/primary"/>

            <!-- Root dot -->
            <View android:layout_width="12dp" android:layout_height="12dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/avatar_bg_green"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>