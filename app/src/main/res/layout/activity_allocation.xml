<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fb">

    <!-- ── PREMIUM HEADER ── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="52dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Eyebrow label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/chip_inactive"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="LEND-A-HAND"
            android:textColor="#aaffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community Requests"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="People who need what you have"
            android:textColor="#80ffffff"
            android:textSize="14sp" />

        <!-- Summary pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/chip_inactive"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ "
                android:textColor="#80ffffff"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMatchCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 verified recipients matched"
                android:textColor="#ccffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── SCROLLABLE RECIPIENT LIST ── -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- ══════════════════════════ -->
            <!-- RECIPIENT CARD 1 -->
            <!-- ══════════════════════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp">

                <!-- Depth shadow layer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/card_shadow_layer" />

                <!-- Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecipient1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#ffffff">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Top row: avatar + name + verified badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <!-- Avatar circle -->
                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/avatar_bg_green"
                                android:gravity="center"
                                android:text="JD"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/tvName1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="John Doe"
                                    android:textColor="@color/on_surface"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <!-- Verified badge -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:background="@drawable/verified_badge_bg"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="✓ Verified"
                                    android:textColor="@color/primary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- Item needed badge -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/need_badge_bg"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="📚 Textbooks"
                                android:textColor="#27308a"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Bio -->
                        <TextView
                            android:id="@+id/tvBio1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="I am a second-year engineering student. Access to physical textbooks would help me study better during power outages."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:textStyle="italic"
                            android:layout_marginBottom="16dp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#f0f2f4"
                            android:layout_marginBottom="16dp" />

                        <!-- Needs row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEEDS"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />

                                <TextView
                                    android:id="@+id/tvAmountNeeded1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="5 items"
                                    android:textColor="@color/on_surface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- Amount input -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ALLOCATE"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08"
                                    android:layout_marginBottom="4dp"
                                    android:layout_gravity="end" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:background="@drawable/stepper_bg"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp">

                                    <android.widget.EditText
                                        android:id="@+id/etAllocate1"
                                        android:layout_width="80dp"
                                        android:layout_height="match_parent"
                                        android:background="@android:color/transparent"
                                        android:hint="Amount"
                                        android:inputType="number"
                                        android:textSize="15sp"
                                        android:textColor="@color/on_surface"
                                        android:textColorHint="@color/outline"
                                        android:gravity="center"
                                        android:padding="0dp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Allocate button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAllocate1"
                            style="@style/LendAHand.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="Allocate to John →" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- ══════════════════════════ -->
            <!-- RECIPIENT CARD 2 -->
            <!-- ══════════════════════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/card_shadow_layer" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecipient2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#ffffff">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/avatar_bg_indigo"
                                android:gravity="center"
                                android:text="MJ"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/tvName2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mary Jenkins"
                                    android:textColor="@color/on_surface"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:background="@drawable/verified_badge_bg"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="✓ Verified"
                                    android:textColor="@color/primary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/need_badge_bg"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="🥫 Food"
                                android:textColor="#27308a"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBio2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="A family of five transitioning into permanent housing. We need basic kitchen essentials and non-perishables to start our pantry."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:textStyle="italic"
                            android:layout_marginBottom="16dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#f0f2f4"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEEDS"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />

                                <TextView
                                    android:id="@+id/tvAmountNeeded2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20 items"
                                    android:textColor="@color/on_surface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ALLOCATE"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08"
                                    android:layout_marginBottom="4dp"
                                    android:layout_gravity="end" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:background="@drawable/stepper_bg"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp">

                                    <android.widget.EditText
                                        android:id="@+id/etAllocate2"
                                        android:layout_width="80dp"
                                        android:layout_height="match_parent"
                                        android:background="@android:color/transparent"
                                        android:hint="Amount"
                                        android:inputType="number"
                                        android:textSize="15sp"
                                        android:textColor="@color/on_surface"
                                        android:textColorHint="@color/outline"
                                        android:gravity="center"
                                        android:padding="0dp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAllocate2"
                            style="@style/LendAHand.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="Allocate to Mary →" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- ══════════════════════════ -->
            <!-- RECIPIENT CARD 3 -->
            <!-- ══════════════════════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/card_shadow_layer" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecipient3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#ffffff">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/avatar_bg_gold"
                                android:gravity="center"
                                android:text="LS"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">

                                <TextView
                                    android:id="@+id/tvName3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local Shelter"
                                    android:textColor="@color/on_surface"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:background="@drawable/verified_badge_bg"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="✓ Verified"
                                    android:textColor="@color/primary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/need_badge_bg"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="🏠 Household"
                                android:textColor="#27308a"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBio3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="We need warm blankets and bedding for 20 people this winter. Your contribution will directly keep someone warm tonight."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:textStyle="italic"
                            android:layout_marginBottom="16dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#f0f2f4"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEEDS"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />

                                <TextView
                                    android:id="@+id/tvAmountNeeded3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="50 items"
                                    android:textColor="@color/on_surface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ALLOCATE"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08"
                                    android:layout_marginBottom="4dp"
                                    android:layout_gravity="end" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp"
                                    android:background="@drawable/stepper_bg"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp">

                                    <android.widget.EditText
                                        android:id="@+id/etAllocate3"
                                        android:layout_width="80dp"
                                        android:layout_height="match_parent"
                                        android:background="@android:color/transparent"
                                        android:hint="Amount"
                                        android:inputType="number"
                                        android:textSize="15sp"
                                        android:textColor="@color/on_surface"
                                        android:textColorHint="@color/outline"
                                        android:gravity="center"
                                        android:padding="0dp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAllocate3"
                            style="@style/LendAHand.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="Allocate to Shelter →" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── PREMIUM BOTTOM NAV ── -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/navDiscover"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="◎" android:textSize="22sp" android:textColor="#aab0b8"
                android:layout_gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DISCOVER" android:textSize="8sp" android:textColor="#aab0b8"
                android:textStyle="bold" android:letterSpacing="0.06"
                android:layout_marginTop="2dp" android:layout_gravity="center"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navDonate"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:padding="6dp"
            android:background="@drawable/nav_active_bg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="♥" android:textSize="22sp" android:textColor="@color/primary"
                android:layout_gravity="center"/>
