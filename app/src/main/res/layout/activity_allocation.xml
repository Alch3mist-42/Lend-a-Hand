<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="52dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/label_pill_alpha"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="ASTERA"
            android:textColor="#aaffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community Requests"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="People who need what you have"
            android:textColor="#80ffffff"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- Matched count -->
    <TextView
        android:id="@+id/tvMatchedCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/verified_badge_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="✓ 3 verified recipients matched"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Scrollable recipient cards -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:fillViewport="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvMatchedCount"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recipient Card 1: John Doe -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecipient1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#ffffff">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                                <View
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:background="@drawable/circle_ring_light"
                                    android:alpha="0.4"/>
                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/avatar_bg_green"
                                    android:gravity="center"
                                    android:text="JD"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="John Doe"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="3dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/verified_badge_bg"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="3dp"
                                        android:paddingBottom="3dp"
                                        android:text="✓ Verified"
                                        android:textColor="@color/primary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:layout_marginEnd="6dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/tier2_icon_bg"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="3dp"
                                        android:paddingBottom="3dp"
                                        android:text="📚 Textbooks"
                                        android:textColor="@color/secondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="I am a second-year engineering student. Access to physical textbooks would help me study better during power outages."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:textStyle="italic"
                            android:layout_marginBottom="16dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEEDS"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="5 items"
                                    android:textColor="@color/on_surface"
                                    android:textSize="18sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end"
                                android:layout_marginEnd="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ALLOCATE"
                                    android:textColor="@color/outline"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"/>
                                <EditText
                                    android:id="@+id/etAllocate1"
                                    android:layout_width="80dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/stepper_bg"
                                    android:gravity="center"
                                    android:hint="Amount"
                                    android:inputType="number"
                                    android:textSize="14sp"
                                    android:textColor="@color/on_surface"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllocate1"
                                style="@style/LendAHand.Button.Primary"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:text="Allocate to John →"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Recipient Card 2: Mary Jenkins -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecipient2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#ffffff">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                                <View
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:background="@drawable/circle_ring_light"
                                    android:alpha="0.4"/>
                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/avatar_bg_indigo"
                                    android:gravity="center"
                                    android:text="MJ"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mary Jenkins"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="3dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/verified_badge_bg"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="3dp"
                                        android:paddingBottom="3dp"
                                        android:text="✓ Verified"
                                        android:textColor="@color/primary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:layout_marginEnd="6dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/tier3_icon_bg"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="3dp"
                                        android:paddingBottom="3dp"
                                        android:text="🥫 Food"
                                        android:textColor="@color/primary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="A family of five transitioning into permanent housing. We need basic kitchen essentials and non-perishables to start our pantry."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:textStyle="italic"
                            android:layout_marginBottom="16dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEEDS"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20 items"
                                    android:textColor="@color/on_surface"
                                    android:textSize="18sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end"
                                android:layout_marginEnd="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ALLOCATE"
                                    android:textColor="@color/outline"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"/>
                                <EditText
                                    android:id="@+id/etAllocate2"
                                    android:layout_width="80dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/stepper_bg"
                                    android:gravity="center"
                                    android:hint="Amount"
                                    android:inputType="number"
                                    android:textSize="14sp"
                                    android:textColor="@color/on_surface"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllocate2"
                                style="@style/LendAHand.Button.Primary"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:text="Allocate to Mary →"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Recipient Card 3: Local Shelter -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecipient3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#ffffff">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">
                            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                                <View
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:background="@drawable/circle_ring_light"
                                    android:alpha="0.4"/>
                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/avatar_bg_gold"
                                    android:gravity="center"
                                    android:text="LS"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local Shelter"
                                    android:textColor="@color/on_surface"
                                    android:textSize="16sp"
                                    android:textStyle="bold"/>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="3dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/verified_badge_bg"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="3dp"
                                        android:paddingBottom="3dp"
                                        android:text="✓ Verified"
                                        android:textColor="@color/primary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:layout_marginEnd="6dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/tier1_icon_bg"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:paddingTop="3dp"
                                        android:paddingBottom="3dp"
                                        android:text="🏠 Household"
                                        android:textColor="@color/error"
                                        android:textSize="10sp"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="We need warm blankets and bedding for 20 people this winter. Your contribution will directly keep someone warm tonight."
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:textStyle="italic"
                            android:layout_marginBottom="16dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEEDS"
                                    android:textColor="@color/outline"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="50 items"
                                    android:textColor="@color/on_surface"
                                    android:textSize="18sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="end"
                                android:layout_marginEnd="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ALLOCATE"
                                    android:textColor="@color/outline"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.06"/>
                                <EditText
                                    android:id="@+id/etAllocate3"
                                    android:layout_width="80dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/stepper_bg"
                                    android:gravity="center"
                                    android:hint="Amount"
                                    android:inputType="number"
                                    android:textSize="14sp"
                                    android:textColor="@color/on_surface"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllocate3"
                                style="@style/LendAHand.Button.Primary"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:text="Allocate to Shelter →"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV — no tab active -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_discover"
                android:layout_gravity="center"
                android:tint="#aab0b8"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCOVER"
                android:textSize="8sp"
                android:textColor="#aab0b8"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="3dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDonate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_donate"
                android:layout_gravity="center"
                android:tint="#aab0b8"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DONATE"
                android:textSize="8sp"
                android:textColor="#aab0b8"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="3dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navActivity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_activity"
                android:layout_gravity="center"
                android:tint="#aab0b8"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVITY"
                android:textSize="8sp"
                android:textColor="#aab0b8"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="3dp"
                android:layout_gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp">
            <ImageView
                android:layout_width="24dp"
