<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fb">

    <!-- ── HEADER with metallic shimmer overlay ── -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Base green background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="52dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/chip_inactive"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:text="ASTERA"
                android:textColor="#aaffffff"
                android:textSize="10sp" android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The Guardians Circle"
                android:textColor="@color/white"
                android:textSize="28sp" android:textStyle="bold"
                android:letterSpacing="-0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Honouring those who give the most"
                android:textColor="#80ffffff" android:textSize="14sp"/>

            <!-- ── PODIUM — all three bases aligned at bottom ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="24dp"
                android:weightSum="3">

                <!-- 2nd place -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:elevation="4dp">

                    <FrameLayout android:layout_width="60dp" android:layout_height="60dp"
                        android:layout_gravity="center_horizontal">
                        <View android:layout_width="60dp" android:layout_height="60dp"
                            android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                        <TextView android:layout_width="50dp" android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:background="@drawable/avatar_bg_indigo"
                            android:gravity="center" android:text="EV"
                            android:textColor="@color/white" android:textSize="16sp"
                            android:textStyle="bold"/>
                    </FrameLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Elena V." android:textColor="#ccffffff"
                        android:textSize="12sp" android:textStyle="bold"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="8.2k pts" android:textColor="#80ffffff"
                        android:textSize="11sp" android:layout_gravity="center_horizontal"/>

                    <!-- Podium block 2nd -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginTop="8dp">
                        <View android:layout_width="match_parent" android:layout_height="56dp"
                            android:background="#2affffff"/>
                        <TextView android:layout_width="match_parent" android:layout_height="32dp"
                            android:background="#3affffff" android:gravity="center"
                            android:text="2" android:textColor="@color/white"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- 1st place — tallest -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:elevation="12dp">

                    <!-- Lotus icon -->
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_lotus"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="4dp"/>

                    <FrameLayout android:layout_width="72dp" android:layout_height="72dp"
                        android:layout_gravity="center_horizontal">
                        <View android:layout_width="72dp" android:layout_height="72dp"
                            android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                        <TextView android:layout_width="60dp" android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:background="@drawable/avatar_bg_gold"
                            android:gravity="center" android:text="MT"
                            android:textColor="@color/white" android:textSize="20sp"
                            android:textStyle="bold"/>
                    </FrameLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Marcus T." android:textColor="#ffffff"
                        android:textSize="13sp" android:textStyle="bold"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="12.5k pts" android:textColor="#ccffffff"
                        android:textSize="11sp" android:layout_gravity="center_horizontal"/>

                    <!-- Podium block 1st — tallest -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginTop="8dp">
                        <View android:layout_width="match_parent" android:layout_height="80dp"
                            android:background="#33ffffff"/>
                        <TextView android:layout_width="match_parent" android:layout_height="32dp"
                            android:background="#44ffffff" android:gravity="center"
                            android:text="1" android:textColor="@color/white"
                            android:textSize="20sp" android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- 3rd place — contrasting indigo so it's visible -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:elevation="2dp">

                    <FrameLayout android:layout_width="60dp" android:layout_height="60dp"
                        android:layout_gravity="center_horizontal">
                        <View android:layout_width="60dp" android:layout_height="60dp"
                            android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                        <!-- Changed from avatar_bg_green to avatar_bg_indigo for contrast -->
                        <TextView android:layout_width="50dp" android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:background="@drawable/avatar_bg_indigo"
                            android:gravity="center" android:text="JG"
                            android:textColor="@color/white" android:textSize="16sp"
                            android:textStyle="bold"/>
                    </FrameLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Dr. Julian" android:textColor="#ccffffff"
                        android:textSize="12sp" android:textStyle="bold"
                        android:layout_gravity="center_horizontal" android:layout_marginTop="6dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="7.9k pts" android:textColor="#80ffffff"
                        android:textSize="11sp" android:layout_gravity="center_horizontal"/>

                    <!-- Podium block 3rd -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginTop="8dp">
                        <View android:layout_width="match_parent" android:layout_height="32dp"
                            android:background="#1affffff"/>
                        <TextView android:layout_width="match_parent" android:layout_height="32dp"
                            android:background="#2affffff" android:gravity="center"
                            android:text="3" android:textColor="@color/white"
                            android:textSize="16sp" android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- ── SCROLLABLE LIST ── -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:background="@color/surface"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="20dp" android:paddingBottom="12dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" android:text="ALL DONORS"
                android:textColor="@color/outline" android:textSize="11sp"
                android:textStyle="bold" android:letterSpacing="0.10"/>

            <!-- Rank 1 -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_marginTop="5dp" android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardRank1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card"
                    app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/avatar_bg_gold" android:gravity="center"
                            android:text="1" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
                        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="10dp">
                            <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                            <TextView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_gold" android:gravity="center" android:text="MT" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Marcus Thorne" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Legendary Donor" android:textColor="@color/tertiary_container" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12.5k" android:textColor="@color/on_surface" android:textSize="20sp" android:textStyle="bold" android:layout_gravity="end"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="@color/outline" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_gravity="end"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Rank 2 -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardRank2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/avatar_bg_indigo" android:gravity="center" android:text="2" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
                        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="10dp">
                            <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                            <TextView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_indigo" android:gravity="center" android:text="EV" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Elena Vance" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pillar of Support" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8.2k" android:textColor="@color/on_surface" android:textSize="20sp" android:textStyle="bold" android:layout_gravity="end"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="@color/outline" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_gravity="end"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Rank 3 -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardRank3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/avatar_bg_green" android:gravity="center" android:text="3" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
                        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="10dp">
                            <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                            <TextView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_indigo" android:gravity="center" android:text="JG" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dr. Julian Gray" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pillar of Support" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7.9k" android:textColor="@color/on_surface" android:textSize="20sp" android:textStyle="bold" android:layout_gravity="end"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="@color/outline" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_gravity="end"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Rank 4 -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardRank4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/verified_badge_bg" android:gravity="center" android:text="4" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold"/>
                        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="10dp">
                            <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                            <TextView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_indigo" android:gravity="center" android:text="SA" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sarah Adeyemi" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rising Guardian" android:textColor="@color/secondary" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5.1k" android:textColor="@color/on_surface" android:textSize="20sp" android:textStyle="bold" android:layout_gravity="end"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="@color/outline" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_gravity="end"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Rank 5 -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/card_shadow_layer"/>
                <androidx.cardview.widget.CardView android:id="@+id/cardRank5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:foreground="@drawable/ripple_card" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#ffffff">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/verified_badge_bg" android:gravity="center" android:text="5" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold"/>
                        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="10dp">
                            <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_ring_light" android:alpha="0.3"/>
                            <TextView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@drawable/avatar_bg_green" android:gravity="center" android:text="KM" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kagiso Molefe" android:textColor="@color/on_surface" android:textSize="15sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Community Helper" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3.4k" android:textColor="@color/on_surface" android:textSize="20sp" android:textStyle="bold" android:layout_gravity="end"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textColor="@color/outline" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08" android:layout_gravity="end"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── BOTTOM NAV with consistent hollow icons ── -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg" android:elevation="12dp"
        android:orientation="horizontal" android:weightSum="4"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/navDiscover" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_discover" android:layout_gravity="center" android:tint="#aab0b8"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISCOVER" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navDonate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_donate" android:layout_gravity="center" android:tint="#aab0b8"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DONATE" android:textSize="8sp" android:textColor="#aab0b8" android:textStyle="bold" android:letterSpacing="0.06" android:layout_marginTop="3dp" android:layout_gravity="center"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navActivity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:background="@drawable/nav_active_bg">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_activity" android:layout_gravity="center"/>
